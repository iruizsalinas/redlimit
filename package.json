{
  "name": "redlimit",
  "version": "2.1.0",
  "private": true,
  "description": "Redis rate limiting with fixed window, sliding window, and token bucket algorithms",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "package": "npm run build && npm run package:prepare",
    "package:prepare": "node scripts/package.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:ci": "node scripts/run-runtime.mjs node",
    "test:prepare": "npm run package:prepare && node scripts/prepare-ci.mjs",
    "test:runtime": "node scripts/run-runtime.mjs",
    "test:package-types": "tsc --ignoreConfig --strict --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --skipLibCheck .ci/consumer/types.mts .ci/consumer/types.cts",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "peerDependencies": {
    "@valkey/valkey-glide": ">=2.5.3",
    "ioredis": ">=5.0.0",
    "iovalkey": ">=0.4.0",
    "redis": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@valkey/valkey-glide": {
      "optional": true
    },
    "iovalkey": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "25.9.6",
    "@valkey/valkey-glide": "2.5.3",
    "@vitest/expect": "4.1.11",
    "chai": "6.3.0",
    "esbuild": "0.28.2",
    "ioredis": "5.11.1",
    "iovalkey": "0.4.0",
    "redis": "5.12.1",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iruizsalinas/redlimit.git"
  },
  "keywords": [
    "redis",
    "ratelimit",
    "backend"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
